              forbidden_operator_bound_Eh=float(forbidden_bound), epsilon_var=args.epsilon, ndet=helper.ndets(), E_var_Eh=energies.tolist(),
              E_var_plus_PT2_Eh=(energies+correction).tolist(), pt2_history=pt2_history,
