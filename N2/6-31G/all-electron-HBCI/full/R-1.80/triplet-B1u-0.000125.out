    forbidden_bound += count * np.linalg.norm(integrals[forbidden])
    integrals[forbidden] = 0.0
if forbidden_bound >= 1e-6:
    raise ValueError(f"Inspect symmetry labels: discarded-operator bound {forbidden_bound} Eh")
